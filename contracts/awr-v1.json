  "change_history": [
    {
      "version": "1.0.1",
      "date": "2026-09-09",
      "basis": "用户在看到六项 p95 实测后表示：我觉得都是毫秒级的就 OK 了吧？",
      "decision": "V1 六项核心操作统一以 p95 <1000 ms 为准入；原 20/20/50/100/100/500 ms 保留为非阻断优化目标。功能、业务场景、Token/Recall 和证据范围不变。"
    },
    {
      "version": "1.1.0",
      "date": "2026-09-09",
      "basis": "用户在侧会话明确要求补齐通用 Init、客户端自动检查点、运行任务登记和恢复核实四项能力。",
      "decision": "追加四个 P0 必需工作项，原 59 项、8 个业务场景及其硬门槛保持不变；旧证据保留日期，不作为新增能力的验证。执行器控制按真实能力提供，任意进程热迁移不纳入本次范围。"
    },
    {
      "version": "1.2.0",
      "date": "2026-09-09",
      "basis": "用户要求补齐项目状态区分、Agent 整理步骤、最小结构与整理后复检。",
      "decision": "追加 AWR-TAKE-005 P0：共享整理诊断覆盖 Init、CLI、MCP 和复检；新接入显式 minimal profile 允许目标与台账共用 YAML、方案/规则文件按需，取代早期 Init 一律生成四类文件的行为。既有 profile 和已配置硬规则保留；profile 绑定来源修订。空台账、占位任务和源声明完成不构成项目完成；原场景和发布门槛不变。"
    }
  ]
