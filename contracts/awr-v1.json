    "scenario_policy": "每场景独立 fixture/namespace/work graph/产物，至少两轮业务追问和独立复核；实际客户端自然语言输入不得携带内部测试 ID、预期答案或状态机步骤；每个完成场景独立提交及远端 SHA。",
    "counting": "只统计当前合同声明且通过全部硬门槛的 completed 条目；筹备、历史、跳过、阻塞和测试探针不计 V1 功能或业务场景完成数。",
    "release": "全部 required V1 work items、8 个场景和 10 个指标通过，已记录发布产物与远端回执；发布决定见 ledger/deliveries。"
  },
  "benchmark_protocol": {
    "fixture": "真实脱敏复杂项目，至少 30 个当前 WorkItem、100 个历史 WorkItem、多 milestone/decision、数百 KB Ledger 和大量 evidence/history。",
    "scale": {
      "work_items_lt": 10000,
      "project_objects_lt": 100000,
      "events_lt": 1000000
    },
    "token_measurement": "固定 tokenizer、版本、源文本集合与同一当前任务，报告估算和实际测量；硬上下文超过预算须显式报错。",
    "latency_measurement": "记录硬件、OS、数据规模、toolchain、冷热缓存；warm 条件预热后至少 30 次，按 p95 比较；冷启动另报。",
    "hard_facts": [
      "work_item_id",
      "status",
      "next_action",
      "acceptance",
      "blocker",
      "applicable_hard_rules",
      "unresolved_required_dependencies"
    ]
  },
