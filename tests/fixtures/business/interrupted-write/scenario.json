  "participants": {
    "executor": {
      "purpose": "在实际客户端推进业务工作并保留工具及产物记录"
    },
    "reviewer": {
      "purpose": "独立检查产物、来源及两轮修订，给出可追溯意见"
    }
  },
  "reviewer_distinct_from": [
    "executor"
  ],
  "initial_request": "刚才工作意外中断了，请核实保留下来的结果，恢复到可以继续推进的状态。",
  "prelude": {
    "request": "请先整理维护交接中需要补充的事项，保留改动建议和已经整理好的内容，暂时不要把建议直接写入权威台账。",
    "required_live_preconditions": [
      "实际客户端先产生真实产物及尚未应用的变更建议。",
      "实际客户端发生可追溯的中断；不得通过预造数据库状态或修改标签声称发生崩溃。",
      "若没有发生实际中断或待应用变更，场景保持待执行，不能用 CLI 探针补齐。"
    ]
  },
  "followups": [
    {
      "number": 1,
      "request": "请查清哪些修改已经保存、哪些还没生效，并补齐交接说明。",
      "publish": [
        {
          "source": "updates/round-1/materials/archive-confirmation.md",
          "target": "materials/archive-confirmation.md",
          "expected_previous_sha256": null
        }
      ],
      "required_observation": "对照真实保存结果和未生效建议，更新交接说明。"
    },
    {
      "number": 2,
      "request": "继续处理剩余工作，确认没有重复写入或丢失结果后交付。",
      "publish": [
        {
          "source": "updates/round-2/materials/role-confirmation.md",
          "target": "materials/role-confirmation.md",
          "expected_previous_sha256": null
        }
      ],
      "required_observation": "应用需要的修订后核对实际来源和回执，保留失败与修订轨迹。"
    }
  ],
  "artifacts": [
